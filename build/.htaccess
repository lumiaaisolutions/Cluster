RewriteEngine On

# Configuración básica de seguridad
Options -Indexes

# Configurar archivos índice por prioridad
DirectoryIndex index.php dashboard.html

# Configurar página de error personalizada  
ErrorDocument 404 /404.html

# ==== REDIRECCIÓN PRINCIPAL DEL DOMINIO ====
# Permitir acceso completo a index.php y permitir que maneje toda la lógica
# No interferir con el funcionamiento normal

# ==== PROTECCIÓN DE RUTAS PRIVADAS ====
# NOTA: La protección de dashboard.html se maneja por auth-session.js + sesiones PHP (CLAUT_SESSION).
# La regla de htaccess que verificaba la cookie 'claut_authenticated' fue ELIMINADA porque
# esa cookie nunca se setea en ninguna parte del sistema, causando redirect permanente a login.
# NO RESTAURAR esta regla sin primero implementar el seteo de la cookie en el login.

# ==== ACCESO DIRECTO A PÁGINAS PÚBLICAS ====
# Permitir acceso directo a páginas de autenticación
RewriteCond %{REQUEST_URI} ^/pages/(sign-in|sign-up|forgot-password)\.html$
RewriteRule .* - [L]

# Permitir acceso a archivos de API y assets sin restricciones
RewriteCond %{REQUEST_URI} ^/(api|assets|js|css|uploads)/
RewriteRule .* - [L]

# Permitir acceso directo a la landing pública (assets, uploads, index.html)
RewriteCond %{REQUEST_URI} ^/landing/
RewriteRule .* - [L]

# Permitir acceso a archivos específicos del sistema
RewriteCond %{REQUEST_URI} ^/(404\.html|robots\.txt|favicon\.ico|sitemap\.xml)$
RewriteRule .* - [L]

# ==== RUTAS DE ADMINISTRACIÓN ====
# Permitir acceso al área de administración
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule .* - [L]

# ==== PÁGINAS DEMO (PANELES ADMIN) — PROTEGIDAS POR SESIÓN ====
# Las demo_*.html son paneles administrativos. Se sirven a través de
# auth-gate.php, que valida la sesión PHP del lado servidor y redirige a
# sign-in si no hay sesión. NO restaurar el acceso directo sin autenticación.
RewriteRule ^demo_([a-z_]+)\.html$ /auth-gate.php?page=demo_$1.html [L,QSA]

# ==== CONFIGURACIONES DE RENDIMIENTO ====
# Configuraciones de cache para optimizar rendimiento
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 3 months"
    ExpiresByType image/jpg "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType image/gif "access plus 3 months"
    ExpiresByType image/webp "access plus 3 months"
    ExpiresByType application/json "access plus 1 day"
</IfModule>

# Configuración de compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ==== CONFIGURACIONES DE SEGURIDAD ====
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CORS — solo dominio de producción Hostinger
    # SECURITY: Sin localhost — la app solo corre en intranet.clautmetropolitano.mx
    Header always set Access-Control-Allow-Origin "https://intranet.clautmetropolitano.mx"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Allow-Credentials "true"

    # Content-Security-Policy — antes solo la enviaba api/upload-image.php
    # (el resto del sitio no tenía CSP en absoluto). unsafe-inline/unsafe-eval
    # se mantienen porque casi todos los HTML del sitio usan <script> inline
    # y atributos onclick="" extensivamente — quitarlos exige externalizar ese
    # JS/CSS en decenas de archivos grandes, un refactor aparte (ver
    # docs/architecture/BACKLOG_2026-08.md), no algo seguro de hacer sin
    # suite de pruebas. Lo que sí se endureció sin tocar código: img-src ya
    # no acepta cualquier origen https, object-src bloqueado.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.tailwindcss.com https://kit.fontawesome.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://use.fontawesome.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://use.fontawesome.com https://kit.fontawesome.com; img-src 'self' data: blob: https://cdnjs.cloudflare.com; connect-src 'self' https://ka-f.fontawesome.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# ==== REGLAS PARA PRETTY URLs ====
# Si necesitas URLs amigables en el futuro
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^([^/]+)/?$ pages/$1.html [NC,L]

# ==== PROTECCIÓN DE ARCHIVOS SENSIBLES ====
# Denegar acceso a archivos de configuración y backups
<Files ~ "\.(env|log|sql|bak|config|ini)$">
    Order allow,deny
    Deny from all
</Files>

# Proteger archivos PHP de configuración
<Files ~ "^(config|database|connection)\.php$">
    Order allow,deny
    Deny from all
</Files>
